{
  "name": "10v12-launcher",
  "version": "1.7.0",
  "description": "10v12 — Minecraft Java launcher",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:mac": "electron-builder --mac dmg",
    "test:lan": "node tests/lan-friends.cjs",
    "test:server": "node tests/server-kit.cjs",
    "test": "node tests/catalog.cjs && node tests/lan-friends.cjs && node tests/server-kit.cjs"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.4"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.tenv12.launcher",
    "productName": "10v12",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**/*",
      "package.json",
      "local-profile.cjs",
      "java-runtime.cjs",
      "visuals-setup.cjs",
      "visuals-mod/**/*",
      "lan-friends.cjs",
      "server-kit/**/*",
      "version-catalog.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "10v12-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games"
    },
    "portable": {
      "artifactName": "10v12-${version}-${arch}-portable.${ext}"
    }
  }
}
